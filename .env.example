# ============================================================================
# BarsGroupProject — environment configuration
# Copy to .env and fill in real values. .NET reads __ as nested config keys.
# ============================================================================

# --- Postgres ---
POSTGRES_USER=courses
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=coursesdb
# DB_HOST is the docker service name; DB_PORT is the in-container port
DB_HOST=postgres
DB_PORT=5432

# --- ASP.NET / JWT ---
# 64+ random chars. Generate: openssl rand -base64 64
JWT__SigningKey=replace_me_with_a_long_random_secret_at_least_64_chars_for_hmacsha512
JWT__Issuer=https://mocki.ru
JWT__Audience=https://mocki.ru

# --- Seed Admin (created on first startup if no user with this email exists) ---
SeedAdmin__Email=admin@bars.local
SeedAdmin__Username=admin
# Must satisfy: 12+ chars, digit, lowercase, uppercase, non-alphanumeric.
SeedAdmin__Password=ChangeMe!Admin123

# --- CORS (frontend origins allowed to call the API) ---
Cors__AllowedOrigins__0=https://mocki.ru
Cors__AllowedOrigins__1=https://www.mocki.ru

# --- Telegram WebApp auth (used by /api/account/telegramAuth) ---
# Get from @BotFather. Leave empty to disable Telegram login.
ConnectionStrings__BotToken=

# --- OpenRouter (quiz generation via LLM) ---
# Get a key at https://openrouter.ai/keys. Leave ApiKey empty to disable AI quiz generation.
OpenRouter__ApiKey=
OpenRouter__Model=openai/gpt-4o-mini
OpenRouter__ApiUrl=https://openrouter.ai/api/v1/chat/completions
# Optional but recommended by OpenRouter for analytics / rate-limit tier:
OpenRouter__HttpReferer=https://mocki.ru
OpenRouter__AppTitle=BarsGroupProject

# --- S3-compatible storage (MinIO / TimeWeb / Yandex Object Storage) ---
# Default: local MinIO behind dev.mocki.ru reverse proxy.
# Backend needs ForcePathStyle (handled automatically by S3StorageService).
S3Config__ServiceURL=https://dev.mocki.ru
S3Config__BucketName=bars-courses
S3Config__AccessKey=
S3Config__SecretKey=
S3Config__Region=us-east-1
S3Config__TempUrlExpiryHours=24
